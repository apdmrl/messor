# PostgreSQL configuration (development and production)
MESSOR_DB_NAME=messor
MESSOR_DB_USER=messor
MESSOR_DB_PASSWORD=replace-with-a-strong-password
MESSOR_DB_PORT=5432

# Backend datasource (development only; production compose builds its own URL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/messor
SPRING_DATASOURCE_USERNAME=messor
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-password

# Demo profile (replace before use; never commit a real password)
MESSOR_DEMO_PASSWORD=replace-with-a-local-demo-password

# Local demo compose (compose.dev.yaml)
# Host port exposed by the frontend gateway (default 8088).
MESSOR_DEV_PORT=8088

# Production compose
# Public port exposed by the Nginx gateway (default 80).
MESSOR_PUBLIC_PORT=80
# Spring profiles for the backend. Use "prod" for a real deployment, or
# "prod,demo" to seed the demo accounts for demonstration.
MESSOR_SPRING_PROFILES_ACTIVE=prod
